{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/dropdown-menu": ["./src/app/ui/helm/dropdown-menu/src/index.ts"],
      "@spartan-ng/helm/utils": ["./src/app/ui/helm/utils/src/index.ts"],
      "@spartan-ng/helm/sheet": ["./src/app/ui/helm/sheet/src/index.ts"],
      "@spartan-ng/helm/button": ["./src/app/ui/helm/button/src/index.ts"],
      "@spartan-ng/helm/dialog": ["./src/app/ui/helm/dialog/src/index.ts"],
      "@spartan-ng/helm/command": ["./src/app/ui/helm/command/src/index.ts"],
      "@spartan-ng/helm/input-group": ["./src/app/ui/helm/input-group/src/index.ts"],
      "@spartan-ng/helm/input": ["./src/app/ui/helm/input/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./src/app/ui/helm/textarea/src/index.ts"],
      "@spartan-ng/helm/tabs": ["./src/app/ui/helm/tabs/src/index.ts"],
      "@spartan-ng/helm/tooltip": ["./src/app/ui/helm/tooltip/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
