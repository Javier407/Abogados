# Copiar a .env y cambiar las claves. El archivo .env no se sube a git.
POSTGRES_DB=gabinete
POSTGRES_USER=gabinete_admin
POSTGRES_PASSWORD=cambiar_esta_clave

# Clave de los usuarios de base de datos de cada servicio (svc_identidad, svc_gabinete, svc_procesos,
# svc_vigilancia, svc_notificaciones). En producción, una clave distinta por servicio.
SVC_PASSWORD=cambiar_esta_clave_tambien

# Usuario de RabbitMQ que usan los servicios para publicar y consumir eventos.
RABBITMQ_USER=abogados
RABBITMQ_PASSWORD=cambiar_esta_clave_de_rabbit

# Correo real (opcional). Si no se definen, los avisos van al buzón de pruebas Mailpit (http://<servidor>:8092).
# OJO: los datos de prueba tienen correos ficticios; no configurar un SMTP real con esa base.
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=587
# SMTP_STARTTLS=true
# SMTP_USUARIO=
# SMTP_CLAVE=
# CORREO_REMITENTE=Gestion Juridica <avisos@tu-dominio.co>
# URL_APP=http://100.65.152.112:8090

# Bot de Telegram para avisos (crearlo en @BotFather). Lo escribe Javier; vacío = canal apagado.
# TELEGRAM_TOKEN=
# Consulta real al portal de la Rama Judicial (solo radicados con fuente PORTAL_HTTP). false = apagada.
# PORTAL_HABILITADO=true
