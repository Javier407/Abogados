# Copiar a .env y cambiar las claves. El archivo .env no se sube a git.
POSTGRES_DB=gabinete
POSTGRES_USER=gabinete_admin
POSTGRES_PASSWORD=cambiar_esta_clave

# Clave de los usuarios de base de datos de cada servicio (svc_identidad, svc_gabinete, svc_procesos,
# svc_vigilancia, svc_notificaciones). En producción, una clave distinta por servicio.
SVC_PASSWORD=cambiar_esta_clave_tambien
